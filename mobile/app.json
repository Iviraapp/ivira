{
  "expo": {
    "name": "IVIRA",
    "slug": "ivira",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080F"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ivira.member",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID for quick sign-in",
        "NSCameraUsageDescription": "Scan QR codes and barcodes at the gym",
        "NSHealthShareUsageDescription": "IVIRA reads your step count, heart rate, and sleep data to track daily activity and recovery",
        "NSHealthUpdateUsageDescription": "IVIRA writes workout and activity data to Apple Health",
        "NSMotionUsageDescription": "IVIRA uses motion data to count your steps throughout the day",
        "NSMicrophoneUsageDescription": "IVIRA uses the microphone during sleep tracking to detect snoring and disturbances. Audio is processed on-device only.",
        "NFCReaderUsageDescription": "Tap your phone on the NFC tag at the gym entrance to check in",
        "NSLocationWhenInUseUsageDescription": "IVIRA uses your location to verify gym check-ins",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "IVIRA uses background location to detect when you arrive at the gym for automatic check-in",
        "UIBackgroundModes": ["location", "audio", "processing", "fetch"]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080F"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#07080F",
        "mdpiDrawable": "./assets/splash.png",
        "hdpiDrawable": "./assets/splash.png",
        "xhdpiDrawable": "./assets/splash.png",
        "xxhdpiDrawable": "./assets/splash.png",
        "xxxhdpiDrawable": "./assets/splash.png"
      },
      "package": "com.ivira.member",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.NFC",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.BODY_SENSORS",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-local-authentication",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3B82F6"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "react-native-health-connect",
      "./plugins/withHealthConnectPermissions",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-nfc-manager",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "IVIRA uses your location to verify gym check-ins"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#07080F",
          "dark": {
            "image": "./assets/splash.png",
            "imageWidth": 200,
            "backgroundColor": "#07080F"
          }
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "apiBase": "https://api.ivira.app/api/v1",
      "geminiKey": "AIzaSyBsEhvajfDjzlconnSc5nca7WoKJ63Aj4M",
      "eas": {
        "projectId": "e554db55-7b14-4d81-b288-723ac43503c6"
      }
    },
    "owner": "gymos2026",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/e554db55-7b14-4d81-b288-723ac43503c6"
    }
  }
}
