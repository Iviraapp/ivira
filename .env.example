# =============================================================================
# IVIRA Backend - Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# IMPORTANT: JWT_SECRET and ADMIN_SECRET are REQUIRED in production (server
#            will refuse to start without them).
# =============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# --- PostgreSQL ---
DATABASE_URL=postgresql://ivira:ivira@localhost:5432/ivira

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Firebase Admin SDK (push notifications) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- WATI (WhatsApp messaging) ---
WATI_API_URL=https://live-server-XXXXX.wati.io
WATI_API_TOKEN=your-wati-api-token

# --- SMS (MSG91 or similar) ---
SMS_AUTH_KEY=your-sms-auth-key
SMS_SENDER_ID=IVIRA

# --- Email ---
# Provider: "resend" (default) or "gmail"
EMAIL_PROVIDER=resend
# Gmail SMTP option:
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Resend option:
RESEND_API_KEY=re_XXXXXXXXXX
# Generic overrides (optional):
EMAIL_USER=
EMAIL_PASSWORD=

# --- JWT (REQUIRED in production -- server throws if missing) ---
JWT_SECRET=generate-a-strong-random-string-here

# --- Admin Secret (REQUIRED in production -- server throws if missing) ---
ADMIN_SECRET=generate-a-strong-random-string-here

# --- AI API Keys (optional -- features auto-enable when set) ---
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Google Places API (gym discovery) ---
GOOGLE_PLACES_API_KEY=

# --- Vercel Blob Storage (file uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Google Wallet (digital membership cards) ---
GOOGLE_WALLET_ISSUER_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_ISSUER_ID=

# --- Apple Wallet (digital membership passes) ---
APPLE_PASS_TYPE_ID=pass.app.ivira.membership
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=

# --- Public URL (callbacks, QR codes, etc.) ---
BASE_URL=http://localhost:4000

# --- App Config ---
TRIAL_DAYS=14
GPS_RADIUS_METERS=150
TRIAL_MAX_MEMBERS=50

# --- Feature Flags ---
ENABLE_TRIAL_GUARD=false
ENABLE_AUDIT_LOG=true
ENABLE_TOKEN_BLACKLIST=true
