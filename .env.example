# ======================
# IVIRA Environment Variables
# ======================
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://gymos:gymos@localhost:5432/gymos

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# Secret for signing JWTs (change in production!)
JWT_SECRET=change-this-to-a-random-secret
# Admin API secret for privileged operations
ADMIN_SECRET=ivira-admin-2026

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Razorpay (Payments) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- WhatsApp (WATI) ---
WATI_API_URL=https://live-server-XXXXX.wati.io
WATI_API_TOKEN=your-wati-token

# --- SMS (MSG91 or similar) ---
SMS_AUTH_KEY=your-sms-auth-key
SMS_SENDER_ID=IVIRA

# --- Gmail SMTP (for Email OTP login) ---
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# --- AI Providers ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
DEEPSEEK_API_KEY=your-deepseek-key
OPENROUTER_API_KEY=your-openrouter-key

# --- Google Places API ---
# Enable "Places API" and "Places API (New)" in your Google Cloud project
# Get key at https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# --- Vercel Blob Storage ---
BLOB_READ_WRITE_TOKEN=your-blob-token

# --- App Settings ---
# Number of free trial days for new gyms
TRIAL_DAYS=14
# GPS check-in radius in meters
GPS_RADIUS_METERS=150
# Max members allowed during trial
TRIAL_MAX_MEMBERS=50
