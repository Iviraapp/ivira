{
  "name": "ivira",
  "version": "1.0.0",
  "description": "IVIRA - Indian gym management SaaS platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "keywords": [
    "gym",
    "saas",
    "india",
    "management"
  ],
  "license": "PROPRIETARY",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@vercel/blob": "^1.1.1",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "firebase-admin": "^13.7.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "nanoid": "^3.3.11",
    "nodemailer": "^8.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "razorpay": "^2.9.6",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
