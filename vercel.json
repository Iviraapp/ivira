{
  "outputDirectory": "public/app",
  "buildCommand": "cd client && npm install && npm run build",
  "installCommand": "cd client && npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.ivira.app/api/:path*" },
    { "source": "/health", "destination": "https://api.ivira.app/health" },
    { "source": "/r/:path*", "destination": "https://api.ivira.app/r/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
